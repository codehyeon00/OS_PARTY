# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: 실제 비밀 값이 들어가는 파일은 올리지 않고, 예시 파일만 허용
.env
.env.*
!.env.example

# 비밀 키 / 인증서
*.pem
*.key
*.p12
*.pfx
service-account*.json
secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
