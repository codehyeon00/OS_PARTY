# OS Party 환경변수 목록 (이름만 적는 예시 파일입니다)
# 사용법: 이 파일을 ".env.local" 이름으로 복사한 뒤 실제 값을 채우세요.
# ".env.local" 은 .gitignore 로 보호되어 GitHub 에 올라가지 않습니다.
# 이 파일(.env.example)에는 절대 실제 키를 적지 마세요.

# --- Supabase (다음 단계에서 연결 예정, 지금은 사용하지 않음) ---
# 브라우저에 공개되어도 되는 값 (NEXT_PUBLIC_ 로 시작)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀 키. 절대 NEXT_PUBLIC_ 를 붙이지 말고, 브라우저 코드에서 쓰지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# --- 사이트 주소 (로그인 리다이렉트 등에 사용 예정) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
